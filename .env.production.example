# ==============================================================================
# Vishwakarma Nexus - Production Environment Configuration Template
# ==============================================================================

# --- APPLICATION RUNTIME ---
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=https://nexus.vkc.org,https://www.nexus.vkc.org

# --- POSTGRESQL DATABASE ---
# When running with docker-compose.prod.yml, host is "db" and internal port is 5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD_IN_PRODUCTION
POSTGRES_DB=vishwakarma_prod
DATABASE_URL=postgres://postgres:CHANGE_THIS_TO_STRONG_PASSWORD_IN_PRODUCTION@db:5432/vishwakarma_prod
AUDIT_RETENTION_DAYS=180

# --- REDIS DISTRIBUTED CACHE & QUEUE ---
# When running with docker-compose.prod.yml, host is "redis"
REDIS_URL=redis://redis:6379
# REDIS_PASSWORD=OPTIONAL_STRONG_REDIS_PASSWORD
REDIS_DB=0
REDIS_PREFIX=vkc:prod:

# --- AUTHENTICATION & SECURITY ---
# Generate using: openssl rand -hex 32 (must be at least 32 characters)
JWT_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_64_CHAR_HEX_SECRET
JWT_EXPIRES_IN=7d
INITIAL_ADMIN_IDENTIFIER=+919876543210

# --- PII MASKING & HASHING SALT (Optional) ---
# PEPPER_SECRET=REPLACE_WITH_OPTIONAL_PEPPER_SECRET

# --- OPTIONAL: FIREBASE CREDENTIALS (NOT REQUIRED FOR PHONE/MPIN AUTH) ---
# Only provide if you configure Firebase Cloud Messaging or SMS gateway in future
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
