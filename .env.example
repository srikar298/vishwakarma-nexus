# --- DATABASE CONFIGURATION ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=vishwakarma-k-c
# Use "localhost" for local dev, "db" for Docker internal network
DATABASE_URL=postgres://postgres:password@localhost:5433/vishwakarma-k-c

# --- BACKEND CONFIGURATION ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- SUPABASE (LACY FOR NOW) ---
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- GOOGLE APPS SCRIPT CONFIGURATION ---
# The URL of your deployed Google Apps Script Web App for seeding data to Google Sheets
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your-deployed-script-id/exec
